{
  "name": "strata-vscode",
  "displayName": "StrataDB",
  "description": "Live, read-only window on Strata databases: explorer, branches, time travel, primitive views, and agent enablement.",
  "version": "0.1.0",
  "publisher": "stratalab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stratalab/strata-vscode.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces StrataDB is attach-only: it connects to existing database sockets but never executes the strata binary (no host start, no doctor, no clone, no MCP registration).",
      "restrictedConfigurations": [
        "strata.binaryPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "StrataDB needs local file access and a local Unix domain socket to reach a database."
    }
  },
  "activationEvents": [
    "workspaceContains:**/manifest/current",
    "workspaceContains:**/manifest/current.object",
    "workspaceContains:**/strata.sock"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "strata",
          "title": "StrataDB",
          "icon": "media/strata.svg"
        }
      ]
    },
    "views": {
      "strata": [
        {
          "id": "strataExplorer",
          "name": "Explorer",
          "contextualTitle": "StrataDB"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "strataExplorer",
        "contents": "No Strata databases attached yet.\nDatabase discovery and attach land in M2 \u2014 see docs/implementation-plan.md."
      }
    ],
    "commands": [
      {
        "command": "strata.refreshDatabases",
        "title": "Refresh Databases",
        "category": "Strata",
        "icon": "$(refresh)"
      },
      {
        "command": "strata.startHost",
        "title": "Start Database Host",
        "category": "Strata"
      },
      {
        "command": "strata.stopHost",
        "title": "Stop Database Host",
        "category": "Strata"
      },
      {
        "command": "strata.inspectRow",
        "title": "Inspect Row",
        "category": "Strata"
      },
      {
        "command": "strata.copyWireJson",
        "title": "Copy as Wire JSON",
        "category": "Strata"
      },
      {
        "command": "strata.copyCli",
        "title": "Copy as CLI Command",
        "category": "Strata"
      },
      {
        "command": "strata.loadMore",
        "title": "Load More",
        "category": "Strata"
      },
      {
        "command": "strata.runDoctor",
        "title": "Run Doctor",
        "category": "Strata"
      }
    ],
    "configuration": {
      "title": "StrataDB",
      "properties": {
        "strata.binaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the `strata` CLI binary. Machine-scoped and never read from workspace settings (workspace trust, AR-7.5). When empty, `strata` is resolved from `PATH`."
        },
        "strata.databases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Explicit Strata database paths to attach, beyond workspace discovery."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "strata.refreshDatabases",
          "when": "view == strataExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "strata.startHost",
          "when": "view == strataExplorer && viewItem == strata-db:unowned && isWorkspaceTrusted",
          "group": "strata@1"
        },
        {
          "command": "strata.stopHost",
          "when": "view == strataExplorer && viewItem =~ /^strata-db:attachable:managed$/",
          "group": "strata@1"
        },
        {
          "command": "strata.runDoctor",
          "when": "view == strataExplorer && viewItem =~ /^strata-db:(owned-unreachable|version-mismatch|pre-v1-layout|at-capacity)/ && isWorkspaceTrusted",
          "group": "strata@2"
        },
        {
          "command": "strata.copyWireJson",
          "when": "view == strataExplorer && viewItem =~ /^strata-(kv-entry|json-doc)$/",
          "group": "strata-copy@1"
        },
        {
          "command": "strata.copyCli",
          "when": "view == strataExplorer && viewItem =~ /^strata-(kv-entry|json-doc)$/",
          "group": "strata-copy@2"
        }
      ],
      "commandPalette": [
        {
          "command": "strata.inspectRow",
          "when": "false"
        },
        {
          "command": "strata.loadMore",
          "when": "false"
        },
        {
          "command": "strata.copyWireJson",
          "when": "false"
        },
        {
          "command": "strata.copyCli",
          "when": "false"
        },
        {
          "command": "strata.startHost",
          "when": "false"
        },
        {
          "command": "strata.stopHost",
          "when": "false"
        },
        {
          "command": "strata.runDoctor",
          "when": "false"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "strata.gettingStarted",
        "title": "Get started with StrataDB",
        "description": "Attach to a live Strata database and watch it change.",
        "steps": [
          {
            "id": "strata.step.find",
            "title": "Find or add a database",
            "description": "Open a folder containing a Strata database, or add paths via the ``strata.databases`` setting.\n[Open Settings](command:workbench.action.openSettings?%22strata.databases%22)",
            "media": {
              "markdown": "media/walkthrough/find-database.md"
            }
          },
          {
            "id": "strata.step.cli",
            "title": "Install the strata CLI",
            "description": "Attaching to an existing host needs no binary. Starting a host or running doctor does \u2014 point ``strata.binaryPath`` at it.\n[Open Settings](command:workbench.action.openSettings?%22strata.binaryPath%22)",
            "media": {
              "markdown": "media/walkthrough/install-cli.md"
            }
          },
          {
            "id": "strata.step.host",
            "title": "Start a database host",
            "description": "An unowned database offers **Start Database Host** in the explorer \u2014 every other process can then attach too.",
            "media": {
              "markdown": "media/walkthrough/start-host.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vendor": "tsx tools/vendor.ts",
    "generate": "tsx tools/generate.ts",
    "guard": "tsx tools/coverage-guard.ts",
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run test/unit",
    "compile:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e": "npm run compile:e2e && tsx test/e2e/runTest.ts",
    "vscode:prepublish": "npm run generate -- --check && npm run build",
    "test:integration": "vitest run test/integration"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.0",
    "glob": "^11.0.0",
    "mocha": "^10.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.10",
    "yaml": "^2.7.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.7"
  }
}
