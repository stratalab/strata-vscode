{
  "name": "strata-vscode",
  "displayName": "StrataDB",
  "description": "Live Strata database explorer with branches, time travel, primitive views, StrataHub, and agent enablement.",
  "version": "0.1.0",
  "publisher": "stratalab",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#E07A5F",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stratalab/strata-vscode.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces StrataDB is connect-only: it connects to existing database sockets but never executes the strata binary (no host start, no doctor, no clone, no branch fork, no KV/JSON edits, no MCP registration).",
      "restrictedConfigurations": [
        "strata.binaryPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "StrataDB needs local file access and a local Unix domain socket to reach a database."
    }
  },
  "activationEvents": [
    "workspaceContains:**/manifest/current",
    "workspaceContains:**/manifest/current.object",
    "workspaceContains:**/manifest/current.object@",
    "workspaceContains:**/strata.sock"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "strata",
          "title": "StrataDB",
          "icon": "media/strata.svg"
        }
      ]
    },
    "views": {
      "strata": [
        {
          "id": "strataExplorer",
          "name": "Explorer",
          "contextualTitle": "StrataDB"
        },
        {
          "id": "strataAgent",
          "name": "AI Agent",
          "type": "webview",
          "contextualTitle": "StrataDB"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "strataExplorer",
        "contents": "Open a folder containing a Strata database and it appears here, live.\n[Browse StrataHub Datasets](command:strata.browseHub)\n[Create New Database](command:strata.createDatabase)\n[Connect Existing Database](command:strata.connectDatabase)\n[Open Folder](command:vscode.openFolder)\nNew to Strata? [Follow the walkthrough](command:workbench.action.openWalkthrough?%22stratalab.strata-vscode%23strata.gettingStarted%22)."
      },
      {
        "view": "strataAgent",
        "contents": "Connect or clone a Strata database to prepare AI-agent context.\n[Connect Existing Database](command:strata.connectDatabase)\n[Browse StrataHub Datasets](command:strata.browseHub)\n[Open Strata Status](command:strata.openStatus)"
      }
    ],
    "commands": [
      {
        "command": "strata.createDatabase",
        "title": "Create New Database…",
        "category": "Strata",
        "icon": "$(add)"
      },
      {
        "command": "strata.connectDatabase",
        "title": "Connect Existing Database…",
        "category": "Strata",
        "icon": "$(folder-opened)"
      },
      {
        "command": "strata.connectDatabaseItem",
        "title": "Connect",
        "category": "Strata",
        "icon": "$(debug-start)"
      },
      {
        "command": "strata.disconnectDatabase",
        "title": "Disconnect",
        "category": "Strata",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "strata.removeDatabase",
        "title": "Remove Database",
        "category": "Strata",
        "icon": "$(close)"
      },
      {
        "command": "strata.refreshDatabases",
        "title": "Refresh Databases",
        "category": "Strata",
        "icon": "$(refresh)"
      },
      {
        "command": "strata.statusMenu",
        "title": "Status…",
        "category": "Strata"
      },
      {
        "command": "strata.openStatus",
        "title": "Open Strata Status…",
        "category": "Strata",
        "icon": "$(heart-pulse)"
      },
      {
        "command": "strata.startHost",
        "title": "Start Database Host",
        "category": "Strata"
      },
      {
        "command": "strata.stopHost",
        "title": "Stop Database Host",
        "category": "Strata"
      },
      {
        "command": "strata.inspectRow",
        "title": "Inspect Row",
        "category": "Strata"
      },
      {
        "command": "strata.copyWireJson",
        "title": "Copy as Wire JSON",
        "category": "Strata"
      },
      {
        "command": "strata.copyCli",
        "title": "Copy as CLI Command",
        "category": "Strata"
      },
      {
        "command": "strata.loadMore",
        "title": "Load More",
        "category": "Strata"
      },
      {
        "command": "strata.runDoctor",
        "title": "Run Doctor",
        "category": "Strata"
      },
      {
        "command": "strata.runCommand",
        "title": "Run Command…",
        "category": "Strata"
      },
      {
        "command": "strata.rawRequest",
        "title": "New Raw Wire Request…",
        "category": "Strata"
      },
      {
        "command": "strata.sendRawRequest",
        "title": "Send Raw Request",
        "category": "Strata"
      },
      {
        "command": "strata.consoleHistory",
        "title": "Console History…",
        "category": "Strata"
      },
      {
        "command": "strata.selectBranch",
        "title": "Select Branch…",
        "category": "Strata"
      },
      {
        "command": "strata.timeTravel",
        "title": "Time Travel…",
        "category": "Strata"
      },
      {
        "command": "strata.keyHistory",
        "title": "Key History…",
        "category": "Strata"
      },
      {
        "command": "strata.compareBranches",
        "title": "Compare Across Branches…",
        "category": "Strata"
      },
      {
        "command": "strata.forkBranch",
        "title": "Fork Branch…",
        "category": "Strata",
        "icon": "$(git-branch)"
      },
      {
        "command": "strata.diffBranches",
        "title": "Diff Branches…",
        "category": "Strata",
        "icon": "$(diff)"
      },
      {
        "command": "strata.copyBranchHandoff",
        "title": "Copy Agent Branch Handoff",
        "category": "Strata",
        "icon": "$(copy)"
      },
      {
        "command": "strata.openView",
        "title": "Open Primitive View",
        "category": "Strata"
      },
      {
        "command": "strata.cloneDataset",
        "title": "Clone Dataset from StrataHub…",
        "category": "Strata"
      },
      {
        "command": "strata.browseHub",
        "title": "Browse StrataHub Datasets…",
        "category": "Strata",
        "icon": "$(cloud-download)"
      },
      {
        "command": "strata.copyMcpSetup",
        "title": "Copy MCP Setup for this Database",
        "category": "Strata",
        "icon": "$(copy)"
      },
      {
        "command": "strata.copyStarterSnippet",
        "title": "Copy TypeScript/Python Starter Snippet…",
        "category": "Strata",
        "icon": "$(code)"
      },
      {
        "command": "strata.openPrimitiveDocs",
        "title": "Open Strata API Docs for this Primitive",
        "category": "Strata",
        "icon": "$(book)"
      },
      {
        "command": "strata.registerAgents",
        "title": "Register with AI Agents",
        "category": "Strata"
      },
      {
        "command": "strata.removeAgentRegistrations",
        "title": "Remove Agent Registrations",
        "category": "Strata"
      }
    ],
    "configuration": {
      "title": "StrataDB",
      "properties": {
        "strata.binaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the `strata` CLI binary (strata ≥ 1.2.1 recommended for Hub browse/progress, wall-clock commit display, and explicit branch/KV/JSON actions; V1 IPC remains best-effort for older 1.x builds). Machine-scoped and never read from workspace settings (workspace trust, AR-7.5). When empty, `strata` is resolved from `PATH`."
        },
        "strata.databases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Explicit Strata database paths to connect, beyond workspace discovery."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "strata.createDatabase",
          "when": "view == strataExplorer && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "strata.connectDatabase",
          "when": "view == strataExplorer",
          "group": "navigation@2"
        },
        {
          "command": "strata.browseHub",
          "when": "view == strataExplorer",
          "group": "navigation@3"
        },
        {
          "command": "strata.openStatus",
          "when": "view == strataExplorer",
          "group": "navigation@4"
        },
        {
          "command": "strata.refreshDatabases",
          "when": "view == strataExplorer",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "strata.startHost",
          "when": "view == strataExplorer && viewItem == strata-db:unowned && isWorkspaceTrusted",
          "group": "strata@1"
        },
        {
          "command": "strata.connectDatabaseItem",
          "when": "view == strataExplorer && viewItem == strata-db:disconnected",
          "group": "strata@1"
        },
        {
          "command": "strata.disconnectDatabase",
          "when": "view == strataExplorer && viewItem =~ /^strata-db:attachable/",
          "group": "strata@1"
        },
        {
          "command": "strata.removeDatabase",
          "when": "view == strataExplorer && viewItem =~ /^strata-db:/",
          "group": "strata@9"
        },
        {
          "command": "strata.copyMcpSetup",
          "when": "view == strataExplorer && viewItem =~ /^strata-db:/",
          "group": "strata-agent@1"
        },
        {
          "command": "strata.copyStarterSnippet",
          "when": "view == strataExplorer && viewItem =~ /^strata-db:/",
          "group": "strata-agent@2"
        },
        {
          "command": "strata.forkBranch",
          "when": "view == strataExplorer && viewItem =~ /^strata-db:attachable/ && isWorkspaceTrusted",
          "group": "strata-branch@1"
        },
        {
          "command": "strata.diffBranches",
          "when": "view == strataExplorer && viewItem =~ /^strata-db:attachable/",
          "group": "strata-branch@2"
        },
        {
          "command": "strata.copyBranchHandoff",
          "when": "view == strataExplorer && viewItem =~ /^strata-db:attachable/",
          "group": "strata-agent@3"
        },
        {
          "command": "strata.forkBranch",
          "when": "view == strataExplorer && viewItem =~ /^strata-branch/ && isWorkspaceTrusted",
          "group": "strata-branch@1"
        },
        {
          "command": "strata.diffBranches",
          "when": "view == strataExplorer && viewItem =~ /^strata-branch/",
          "group": "strata-branch@2"
        },
        {
          "command": "strata.copyBranchHandoff",
          "when": "view == strataExplorer && viewItem =~ /^strata-branch/",
          "group": "strata-agent@1"
        },
        {
          "command": "strata.copyStarterSnippet",
          "when": "view == strataExplorer && viewItem =~ /^strata-primitive:/",
          "group": "strata-agent@2"
        },
        {
          "command": "strata.openPrimitiveDocs",
          "when": "view == strataExplorer && viewItem =~ /^strata-primitive:/",
          "group": "strata-docs@1"
        },
        {
          "command": "strata.runDoctor",
          "when": "view == strataExplorer && viewItem =~ /^strata-db:(owned-unreachable|version-mismatch|pre-v1-layout|at-capacity)/ && isWorkspaceTrusted",
          "group": "strata@2"
        },
        {
          "command": "strata.copyWireJson",
          "when": "view == strataExplorer && viewItem =~ /^strata-(kv-entry|json-doc)$/",
          "group": "strata-copy@1"
        },
        {
          "command": "strata.copyCli",
          "when": "view == strataExplorer && viewItem =~ /^strata-(kv-entry|json-doc)$/",
          "group": "strata-copy@2"
        },
        {
          "command": "strata.keyHistory",
          "when": "view == strataExplorer && viewItem =~ /^strata-(kv-entry|json-doc)$/",
          "group": "strata-history@1"
        },
        {
          "command": "strata.compareBranches",
          "when": "view == strataExplorer && viewItem =~ /^strata-(kv-entry|json-doc)$/",
          "group": "strata-history@2"
        }
      ],
      "commandPalette": [
        {
          "command": "strata.inspectRow",
          "when": "false"
        },
        {
          "command": "strata.statusMenu",
          "when": "false"
        },
        {
          "command": "strata.loadMore",
          "when": "false"
        },
        {
          "command": "strata.copyWireJson",
          "when": "false"
        },
        {
          "command": "strata.copyCli",
          "when": "false"
        },
        {
          "command": "strata.startHost",
          "when": "false"
        },
        {
          "command": "strata.stopHost",
          "when": "false"
        },
        {
          "command": "strata.connectDatabaseItem",
          "when": "false"
        },
        {
          "command": "strata.disconnectDatabase",
          "when": "false"
        },
        {
          "command": "strata.removeDatabase",
          "when": "false"
        },
        {
          "command": "strata.runDoctor",
          "when": "false"
        },
        {
          "command": "strata.keyHistory",
          "when": "false"
        },
        {
          "command": "strata.compareBranches",
          "when": "false"
        },
        {
          "command": "strata.openView",
          "when": "false"
        },
        {
          "command": "strata.copyMcpSetup",
          "when": "false"
        },
        {
          "command": "strata.copyStarterSnippet",
          "when": "false"
        },
        {
          "command": "strata.openPrimitiveDocs",
          "when": "false"
        },
        {
          "command": "strata.cloneDataset",
          "when": "false"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "strata.gettingStarted",
        "title": "Get started with StrataDB",
        "description": "Connect to a live Strata database, watch it change, and scrub back in time.",
        "steps": [
          {
            "id": "strata.step.find",
            "title": "Find or add a database",
            "description": "Open a folder that contains a Strata database — StrataDB recognizes the layout and shows every database with its connection state. You can also create a new local database or connect an existing database outside the workspace.\n[Create New Database](command:strata.createDatabase)\n[Connect Existing Database](command:strata.connectDatabase)",
            "media": {
              "image": "media/walkthrough/find-database.svg",
              "altText": "The StrataDB explorer listing three databases: one connected and hosting with three sessions, one unowned offering Start Database Host, and one whose layout needs attention."
            },
            "completionEvents": [
              "onView:strataExplorer"
            ]
          },
          {
            "id": "strata.step.host",
            "title": "Start a database host",
            "description": "Connecting to a running host needs no binary. When a database is unowned, **Start Database Host** spawns ``strata start`` — your app, the CLI, and this window all connect to the same socket.\n[Set Binary Path](command:workbench.action.openSettings?%22strata.binaryPath%22)",
            "media": {
              "image": "media/walkthrough/start-host.svg",
              "altText": "The Start Database Host action spawns strata start, which owns the socket while your app, the strata repl, and this window connect alongside."
            },
            "completionEvents": [
              "onCommand:strata.startHost"
            ]
          },
          {
            "id": "strata.step.live",
            "title": "Watch it change live",
            "description": "Open any primitive from the explorer and leave it up while your app or agent works. Views refresh on push — never by polling — and the event feed holds your place while new events land.",
            "media": {
              "image": "media/walkthrough/watch-live.svg",
              "altText": "The live event feed: typed events streaming under a Live banner, the newest arrival highlighted with a green edge, and a pill offering the jump to one new event."
            },
            "completionEvents": [
              "onCommand:strata.openView"
            ]
          },
          {
            "id": "strata.step.scrub",
            "title": "Scrub back in time",
            "description": "Every row's history is a rail you can stand on: pick a moment and the whole database view moves there, wearing an amber wash until you come back.\n[Time Travel…](command:strata.timeTravel)",
            "media": {
              "image": "media/walkthrough/scrub-time.svg",
              "altText": "A table washed amber under a banner reading as of Aug 5, 2026 14:18 with a Back to now button, beside the history rail with the viewed moment marked in amber."
            },
            "completionEvents": [
              "onCommand:strata.timeTravel"
            ]
          },
          {
            "id": "strata.step.agents",
            "title": "Register with AI agents",
            "description": "One consent registers Strata with the agents in this workspace — VS Code agent mode natively, Cursor and Claude Code via their MCP config files. Watch the agent's session appear in the status bar.\n[Register with AI Agents](command:strata.registerAgents)",
            "media": {
              "image": "media/walkthrough/register-agents.svg",
              "altText": "A consent card that registers Strata with VS Code agent mode, Cursor, and Claude Code, above a status bar where the agent's session has just connected."
            },
            "completionEvents": [
              "onCommand:strata.registerAgents"
            ]
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "strata",
        "label": "StrataDB"
      }
    ]
  },
  "scripts": {
    "vendor": "tsx tools/vendor.ts",
    "generate": "tsx tools/generate.ts",
    "guard": "tsx tools/coverage-guard.ts",
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run test/unit",
    "compile:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e": "npm run compile:e2e && tsx test/e2e/runTest.ts",
    "vscode:prepublish": "npm run generate -- --check && npm run build",
    "test:integration": "vitest run test/integration",
    "test:visual": "npm run build && playwright test --config test/visual/playwright.config.ts",
    "storefront": "npm run build && tsx tools/storefront.ts",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "~1.101.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "axe-core": "^4.13.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.0",
    "gifenc": "^1.0.3",
    "glob": "^11.0.0",
    "jsdom": "^29.1.1",
    "mocha": "^10.8.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.10",
    "yaml": "^2.7.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.7"
  },
  "keywords": [
    "strata",
    "stratadb",
    "database",
    "agent",
    "memory",
    "mcp",
    "time-travel"
  ]
}
